# Local settings (copy to .env; .env is not committed)
# Ultimate devices for `make deploy` / `make deploy2` (IP only)
ULTIP1 = 192.168.1.xx
# ULTIP2 = 192.168.1.yy
# ULTUSB = usb0
# ULTPATH = Dev
# Oscar64 with the fast-call range fix (see lib/geos-oscar64 manual, section 10)
# OSCAR64 = /path/to/oscar64/bin/oscar64
# Library checkout to use instead of the submodule (library development)
# GEOSLIB = /path/to/geos-oscar64
